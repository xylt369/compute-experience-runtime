{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compute-experience.dev/schema/model-manifest.json",
  "title": "Compute Experience Model Manifest",
  "type": "object",
  "required": ["id", "name", "description", "version", "parameters", "state", "renderer"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "version": {"type": "string"},
    "renderer": {"type": "string"},
    "state": {"type": "array", "items": {"type": "string"}},
    "derived": {"type": "array", "items": {"type": "string"}},
    "time": {"type": "object"},
    "capabilities": {"type": "object"},
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "type", "default"],
        "properties": {
          "id": {"type": "string"},
          "label": {"type": "string"},
          "type": {"enum": ["number", "boolean", "enum"]},
          "default": {},
          "min": {"type": "number"},
          "max": {"type": "number"},
          "step": {"type": "number", "exclusiveMinimum": 0},
          "unit": {"type": "string"},
          "options": {"type": "array", "items": {"type": "string"}, "minItems": 1}
        },
        "allOf": [
          {"if": {"properties": {"type": {"const": "number"}}}, "then": {"required": ["min", "max", "step"]}},
          {"if": {"properties": {"type": {"const": "enum"}}}, "then": {"required": ["options"]}}
        ]
      }
    }
  }
}
