{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@compute-experience/core": ["packages/core/src/index.ts"],
      "@compute-experience/renderers": ["packages/renderers/src/index.ts"]
    }
  },
  "include": [
    "packages/core/src",
    "packages/renderers/src",
    "playground/src",
    "examples",
    "tests/js",
    "vite.config.ts"
  ]
}
